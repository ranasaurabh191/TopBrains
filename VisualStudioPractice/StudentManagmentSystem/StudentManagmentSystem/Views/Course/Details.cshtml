@model StudentManagmentSystem.Models.Course

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="mb-0 text-white">Course Details</h3>
        <a asp-action="Index" class="btn btn-sm btn-secondary">Back</a>
    </div>
    <div class="card-body">
        <p><strong>Course:</strong> @Model.CourseName</p>
        <p><strong>Duration:</strong> @Model.Duration</p>
        <p><strong>Department:</strong> @Model.Department?.DepartmentName ?? "-"</p>
    </div>
</div>
