@{
}
@model StudentManagmentSystem.Models.Course

<h2>Create Course</h2>

@using (Html.BeginForm())
{

    <p>
        @Html.LabelFor(m => m.CourseName)
        @Html.TextBoxFor(m => m.CourseName)
    </p>

    <p>
        @Html.LabelFor(m => m.Duration)
        @Html.TextBoxFor(m => m.Duration)
    </p>

    <p>

        Department

        @Html.DropDownListFor(m => m.DepartmentId,
        new SelectList(ViewBag.Departments, "DepartmentId", "DepartmentName"))

</p>

<input type="submit" value="Save" />

}