@model StudentManagmentSystem.Models.Student

<h2>Student Details</h2>

<p>
    <strong>ID :</strong> @Model.StudentId
</p>

<p>
    <strong>Name :</strong> @Model.Name
</p>

<p>
    <strong>Email :</strong> @Model.Email
</p>

<p>
    <strong>Age :</strong> @Model.Age
</p>

<p>
    <strong>Gender :</strong> @Model.Gender
</p>

<p>
    <strong>Department :</strong> @Model.Department?.DepartmentName
</p>

<p>
    <a asp-action="Edit" asp-route-id="@Model.StudentId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</p>