@model StudentManagmentSystem.Models.Department

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="mb-0 text-white">Delete Department</h3>
    </div>
    <div class="card-body">
        <p class="mb-3">Are you sure you want to delete this department?</p>
        <p><strong>@Model.DepartmentName</strong></p>

        <form asp-action="Delete" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="DepartmentId" />
            <button type="submit" class="btn btn-danger btn-modern">Delete</button>
            <a asp-action="Index" class="btn btn-secondary btn-modern ms-2">Cancel</a>
        </form>
    </div>
</div>
