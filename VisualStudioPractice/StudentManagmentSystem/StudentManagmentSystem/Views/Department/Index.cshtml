@model IEnumerable<StudentManagmentSystem.Models.Department>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="mb-0 text-white">Departments</h3>
        <a asp-action="Create" class="btn btn-light btn-modern">Create Department</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Department Name</th>
                        <th>Location</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var dept in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@dept.DepartmentName</td>
                                <td class="text-muted">@dept.Location</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@dept.DepartmentId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                    <a asp-action="Details" asp-route-id="@dept.DepartmentId" class="btn btn-sm btn-outline-secondary me-1">Details</a>
                                    <a asp-action="Delete" asp-route-id="@dept.DepartmentId" class="btn btn-sm btn-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">No departments found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
