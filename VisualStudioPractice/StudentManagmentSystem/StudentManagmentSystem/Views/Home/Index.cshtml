@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Student Management Dashboard</h2>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-hover">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted mb-1">Total Students</h6>
                    <h3 class="mb-0">@ViewBag.TotalStudents</h3>
                </div>
                <div class="text-end">
                    <i class="bi bi-people-fill" style="font-size:2rem;opacity:0.85"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-hover">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted mb-1">Total Departments</h6>
                    <h3 class="mb-0">@ViewBag.TotalDepartments</h3>
                </div>
                <div class="text-end">
                    <i class="bi bi-building" style="font-size:2rem;opacity:0.85"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-hover">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted mb-1">Total Courses</h6>
                    <h3 class="mb-0">@ViewBag.TotalCourses</h3>
                </div>
                <div class="text-end">
                    <i class="bi bi-journal-bookmark" style="font-size:2rem;opacity:0.85"></i>
                </div>
            </div>
        </div>
    </div>
</div>
