@{
}
@model CodeFirstDemo.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h2>Employee Details</h2>

<div>
    <dl class="row">

        <dt class="col-sm-2">
            Name
        </dt>

        <dd class="col-sm-10">
            @Model.EmpName
        </dd>

        <dt class="col-sm-2">
            Address
        </dt>

        <dd class="col-sm-10">
            @Model.Address
        </dd>

        <dt class="col-sm-2">
            Salary
        </dt>

        <dd class="col-sm-10">
            @Model.Salary
        </dd>

        <dt class="col-sm-2">
            Email
        </dt>

        <dd class="col-sm-10">
            @Model.Email
        </dd>

    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.EmpID" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>