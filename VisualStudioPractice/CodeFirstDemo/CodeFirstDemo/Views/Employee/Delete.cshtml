@{
}
@model CodeFirstDemo.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<h2>Delete Employee</h2>

<h4>Are you sure you want to delete this?</h4>

<div>
    <dl class="row">

        <dt class="col-sm-2">
            Name
        </dt>

        <dd class="col-sm-10">
            @Model.EmpName
        </dd>

        <dt class="col-sm-2">
            Address
        </dt>

        <dd class="col-sm-10">
            @Model.Address
        </dd>

        <dt class="col-sm-2">
            Salary
        </dt>

        <dd class="col-sm-10">
            @Model.Salary
        </dd>

        <dt class="col-sm-2">
            Email
        </dt>

        <dd class="col-sm-10">
            @Model.Email
        </dd>

    </dl>
</div>

<form asp-action="Delete">

    <input type="hidden" asp-for="EmpID" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>