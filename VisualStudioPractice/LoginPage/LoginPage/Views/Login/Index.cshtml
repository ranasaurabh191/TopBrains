@model IEnumerable<LoginPage.Models.UserLogin>

@{
    ViewData["Title"] = "Users";
}

<h2>Users</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Username</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (var u in Model)
            {
                <tr>
                    <td>@u.id</td>
                    <td>@u.UserName</td>
                </tr>
            }
        }
    </tbody>
</table>